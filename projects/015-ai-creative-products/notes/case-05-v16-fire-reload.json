  "reference": {
    "focus": "第一人称房间生存：瞄准、移动、敌人靠近和波次资源形成实时闭环。",
    "evidence": "作者自述将经典 Zombies 地图移植到浏览器；原片展示第一人称室内场景。",
    "sourceTech": "源码迁移是作者自述；本项目没有原作源码与资产。",
    "ours": "连接的枪身、护木、枪管、握把与枪托，胸腰分明的护甲守卫和暖色门洞导光；真实命中与可躲避近战保留。",
    "tech": "Three.js 原创有限几何与室内灯光；武器和守卫局部关节统一坐标，Raycaster 检查嵌套环境表面，枪口连向实际射线落点，后坐使用活动时钟。",
    "value": "用空间压力与资源限制做安防巡检、应急处置或设备操作训练。",
    "check": "实际门面和机柜阻挡射线，守卫命中才减防护；开火、回正、暂停、真实后退躲避和受伤反应通过，手机实际画面无资源错误。",
    "boundary": "枪械反馈、机器人与机房均为原创有限实现，原作内部机制未知；没有弹道仿真、COD 源码与资产、完整敌人系统或联机。",
    "kernel": "一次有效开火扣电荷并推动枪械后坐；机器人命中才减少防护，环境落点呈现独立火花，枪械回正后继续瞄准。逼近攻击保留可躲避的蓄势、挥击和恢复。"
  },
  "optimization": {
    "caseId": 5,
    "sourceTarget": "原视频室内第一人称生存通过敌人逼近、身体动作与开火/受伤构成可判断威胁；参考可见的战斗动作与反馈，不推断原作AI或弹道算法。",
    "diagnosis": "前景枪械是巨大的拼接方盒，守卫身体缺少连贯的胸腰和肢体，室内光线没有有效引导门洞与巡逻方向。",
    "priority": "重建武器侧面结构、连贯人形护甲与房间灯光，再按真实开火和近战检查模型连接。",
    "changes": [
      "独立武器模块制作连贯机匣、通风护木、枪管、空心枪托、斜握把与瞄具，缩小前景占比。",
      "守卫重做胸甲、腰髋、肩帽和相连臂腿；肘膝合批保留关节局部坐标，修复手脚漂移。",
      "门洞加入室内暖光，柜体保持冷暗层；真实机柜嵌套表面加入射线阻挡，枪口、后坐和命中反馈读取新模型。"
    ],
    "verify": [
      "已检查真实房间、近处守卫与单独模型结构；射击和近战回归通过，无运行错误。",
      "真实门/柜挡住射线，守卫命中才减少防护；枪口起点与新模型对应，后坐不改变瞄准射线。",
      "实际闪避与受伤分别记录距离和蓄势时间，隐藏暂停、窄屏和下载保留同一状态。"
    ],
    "remaining": [
      "武器、护甲与室内仍是原创几何近似；没有原作游戏资产、动画库或离线美术流水线。",
      "仍为简化单人机房关卡，没有弹道仿真、完整敌人系统或联机。"
    ]
  },
  "scope": "原创关卡、有限枪械反馈与简化近战判定；没有 COD 源码、资产或联机。"
