{
  "manifest_version": 3,
  "name": "Forma 网页工具箱",
  "version": "0.1.0",
  "description": "在当前网页划词翻译、保存带来源的摘录、提取真实表格并使用文本小工具。点击图标后才运行。",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "打开 Forma 网页工具箱", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "web_accessible_resources": [{
    "resources": ["assets/toolbox.js", "assets/toolbox.css", "assets/translation.js", "assets/data.js"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
